implementing psdr;

// Differentiable OpenPBR. The OpenPBR library is compiled a second time inside the PSDR
// module, from the copy of external/openpbr-bsdf generated by falcor2/psdr/openpbr.py,
// whose functions are all [Differentiable]; the render module keeps its own build. Library structs are
// made differentiable by extensions: each gets a Differential struct of its float fields, linked to the
// original fields with extern [DerivativeMember] declarations. The energy tables are the render module's
// LUT textures, interpolated in differentiable code (openpbr_lut_2d/3d).

#define OPENPBR_LANGUAGE_TARGET_SLANG 1
#define OPENPBR_UINT16 uint16_t
#define OPENPBR_USE_TEXTURE_LUTS 1
#define OPENPBR_SAMPLE_2D_TEXTURE(lut_id, uv) openpbr_lut_2d(lut_id, uv)
#define OPENPBR_SAMPLE_3D_TEXTURE(lut_id, uv) openpbr_lut_3d(lut_id, uv)
#include "generated/openpbr-bsdf/openpbr_settings.h"
#include "generated/openpbr-bsdf/interop/openpbr_interop.h"
#undef OPENPBR_INLINE_FUNCTION
#undef OPENPBR_GENERAL_CONSTEXPR_FUNCTION
#undef OPENPBR_LIMITED_CONSTEXPR_FUNCTION
#define OPENPBR_INLINE_FUNCTION [Differentiable]
#define OPENPBR_GENERAL_CONSTEXPR_FUNCTION [Differentiable]
#define OPENPBR_LIMITED_CONSTEXPR_FUNCTION [Differentiable]

// The core module's smoothstep has no backward derivative; the library only uses the scalar one.
[Differentiable]
float openpbr_smoothstep(float a, float b, float x)
{
    float t = saturate((x - a) / (b - a));
    return t * t * (3 - 2 * t);
}
#define smoothstep openpbr_smoothstep
#include "generated/openpbr-bsdf/openpbr.h"
#undef smoothstep

#define DIFFERENTIAL_METHODS \
    [Differentiable] static Differential dzero() { return Differential.dzero(); } \
    [Differentiable] static Differential dadd(Differential a, Differential b) { return Differential.dadd(a, b); }

struct OpenPBR_Basis_Differential : IDifferentiable
{
    vec3 t;
    vec3 b;
    vec3 n;
};

extension OpenPBR_Basis : IDifferentiable
{
    typedef OpenPBR_Basis_Differential Differential;
    DIFFERENTIAL_METHODS
    [DerivativeMember(Differential.t)] extern vec3 t;
    [DerivativeMember(Differential.b)] extern vec3 b;
    [DerivativeMember(Differential.n)] extern vec3 n;
};

struct OpenPBR_AnisotropicGGXSmithVNDFMicrofacetDistribution_Differential : IDifferentiable
{
    vec2 alpha;
    OpenPBR_Basis_Differential basis_ff;
    float isotropic_alpha;
};

extension OpenPBR_AnisotropicGGXSmithVNDFMicrofacetDistribution : IDifferentiable
{
    typedef OpenPBR_AnisotropicGGXSmithVNDFMicrofacetDistribution_Differential Differential;
    DIFFERENTIAL_METHODS
    [DerivativeMember(Differential.alpha)] extern vec2 alpha;
    [DerivativeMember(Differential.basis_ff)] extern OpenPBR_Basis basis_ff;
    [DerivativeMember(Differential.isotropic_alpha)] extern float isotropic_alpha;
};

struct OpenPBR_ComprehensiveReflectionTransmissionCoefficient_Differential : IDifferentiable
{
    vec3 eta_t_over_eta_i_for_transparent_part;
    vec3 eta_t_over_eta_i_for_opaque_part;
    vec3 scale_for_reflection_for_transparent_part;
    vec3 scale_for_reflection_for_opaque_part;
    vec3 transmission;
    vec3 f0_for_metal;
    vec3 f82_tint_for_metal;
    float metal_amount;
    float thin_film_weight;
    float thin_film_thickness_nm;
    float thin_film_exterior_ior;
    float thin_film_ior;
    vec3 thin_film_interior_ior;
    vec3 rgb_wavelengths_nm;
    vec3 thin_wall_constant_reflection_albedo;
};

extension OpenPBR_ComprehensiveReflectionTransmissionCoefficient : IDifferentiable
{
    typedef OpenPBR_ComprehensiveReflectionTransmissionCoefficient_Differential Differential;
    DIFFERENTIAL_METHODS
    [DerivativeMember(Differential.eta_t_over_eta_i_for_transparent_part)] extern vec3 eta_t_over_eta_i_for_transparent_part;
    [DerivativeMember(Differential.eta_t_over_eta_i_for_opaque_part)] extern vec3 eta_t_over_eta_i_for_opaque_part;
    [DerivativeMember(Differential.scale_for_reflection_for_transparent_part)] extern vec3 scale_for_reflection_for_transparent_part;
    [DerivativeMember(Differential.scale_for_reflection_for_opaque_part)] extern vec3 scale_for_reflection_for_opaque_part;
    [DerivativeMember(Differential.transmission)] extern vec3 transmission;
    [DerivativeMember(Differential.f0_for_metal)] extern vec3 f0_for_metal;
    [DerivativeMember(Differential.f82_tint_for_metal)] extern vec3 f82_tint_for_metal;
    [DerivativeMember(Differential.metal_amount)] extern float metal_amount;
    [DerivativeMember(Differential.thin_film_weight)] extern float thin_film_weight;
    [DerivativeMember(Differential.thin_film_thickness_nm)] extern float thin_film_thickness_nm;
    [DerivativeMember(Differential.thin_film_exterior_ior)] extern float thin_film_exterior_ior;
    [DerivativeMember(Differential.thin_film_ior)] extern float thin_film_ior;
    [DerivativeMember(Differential.thin_film_interior_ior)] extern vec3 thin_film_interior_ior;
    [DerivativeMember(Differential.rgb_wavelengths_nm)] extern vec3 rgb_wavelengths_nm;
    [DerivativeMember(Differential.thin_wall_constant_reflection_albedo)] extern vec3 thin_wall_constant_reflection_albedo;
};

