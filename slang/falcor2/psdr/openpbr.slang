    [DerivativeMember(Differential.transmission_dispersion_abbe_number)] extern float transmission_dispersion_abbe_number;
    [DerivativeMember(Differential.thin_film_weight)] extern float thin_film_weight;
    [DerivativeMember(Differential.thin_film_thickness)] extern float thin_film_thickness;
    [DerivativeMember(Differential.thin_film_ior)] extern float thin_film_ior;
    [DerivativeMember(Differential.emission_luminance)] extern float emission_luminance;
    [DerivativeMember(Differential.emission_color)] extern vec3 emission_color;
    [DerivativeMember(Differential.geometry_opacity)] extern float geometry_opacity;
    [DerivativeMember(Differential.geometry_basis)] extern OpenPBR_Basis geometry_basis;
    [DerivativeMember(Differential.geometry_coat_basis)] extern OpenPBR_Basis geometry_coat_basis;
};

struct OpenPBR_ThinFilmResults_Differential : IDifferentiable
{
    vec3 reflectance_dielectric;
    vec3 reflectance_metal;
};

extension OpenPBR_ThinFilmResults : IDifferentiable
{
    typedef OpenPBR_ThinFilmResults_Differential Differential;
    DIFFERENTIAL_METHODS
    [DerivativeMember(Differential.reflectance_dielectric)] extern vec3 reflectance_dielectric;
    [DerivativeMember(Differential.reflectance_metal)] extern vec3 reflectance_metal;
};

struct OpenPBR_VolumeDerivedProps_Differential : IDifferentiable
{
    vec3 thin_wall_subsurface_color;
    float thin_wall_subsurface_anisotropy;
    vec3 transmission_tint;
};

extension OpenPBR_VolumeDerivedProps : IDifferentiable
{
    typedef OpenPBR_VolumeDerivedProps_Differential Differential;
    DIFFERENTIAL_METHODS
    [DerivativeMember(Differential.thin_wall_subsurface_color)] extern vec3 thin_wall_subsurface_color;
    [DerivativeMember(Differential.thin_wall_subsurface_anisotropy)] extern float thin_wall_subsurface_anisotropy;
    [DerivativeMember(Differential.transmission_tint)] extern vec3 transmission_tint;
};

/// Layout of the render module's openpbr_globals (OpenPBRMaterial's LUT textures), whose fields are internal.
struct OpenPBRLuts
{
    DescriptorHandle<Texture3D> ideal_dielectric_energy_complement;
    DescriptorHandle<Texture2D> ideal_dielectric_average_energy_complement;
    DescriptorHandle<Texture2D> ideal_dielectric_reflection_ratio;
    DescriptorHandle<Texture3D> opaque_dielectric_energy_complement;
    DescriptorHandle<Texture2D> opaque_dielectric_average_energy_complement;
    DescriptorHandle<Texture2D> ideal_metal_energy_complement;
    DescriptorHandle<Texture2D> ideal_metal_average_energy_complement;
    DescriptorHandle<Texture2D> ltc;
    DescriptorHandle<SamplerState> sampler;
};

/// The table texture of a 2D (or 1D) LUT. The table is chosen once per lookup and its texels are loaded through
/// that one descriptor: a per-texel choice among all tables made every inlined lookup eight table switches.
DescriptorHandle<Texture2D> openpbr_table_2d(const OpenPBR_LutId lut_id)
{
    OpenPBRLuts luts = reinterpret<OpenPBRLuts>(openpbr_globals);
    switch (lut_id) {
    case OpenPBR_LutId_IdealDielectricAverageEnergyComplement:
        return luts.ideal_dielectric_average_energy_complement;
    case OpenPBR_LutId_IdealDielectricReflectionRatio:
        return luts.ideal_dielectric_reflection_ratio;
    case OpenPBR_LutId_OpaqueDielectricAverageEnergyComplement:
        return luts.opaque_dielectric_average_energy_complement;
    case OpenPBR_LutId_IdealMetalEnergyComplement:
        return luts.ideal_metal_energy_complement;
    case OpenPBR_LutId_IdealMetalAverageEnergyComplement:
        return luts.ideal_metal_average_energy_complement;
    default:
        return luts.ltc;
    }
}

/// The table texture of a 3D LUT.
DescriptorHandle<Texture3D> openpbr_table_3d(const OpenPBR_LutId lut_id)
{
    OpenPBRLuts luts = reinterpret<OpenPBRLuts>(openpbr_globals);
    if (lut_id == OpenPBR_LutId_OpaqueDielectricEnergyComplement)
        return luts.opaque_dielectric_energy_complement;
    return luts.ideal_dielectric_energy_complement;
}

float4 openpbr_texel_2d(DescriptorHandle<Texture2D> t, int2 p) { return t.Load(int3(p, 0)); }
float4 openpbr_texel_3d(DescriptorHandle<Texture3D> t, int3 p) { return t.Load(int4(p, 0)); }

/// Linear interpolation of a table's texels around continuous texel coordinate p (the lookup of a sampler
/// with linear filtering and clamping), differentiable with respect to p.
[Differentiable]
float4 openpbr_lut_bilinear(no_diff DescriptorHandle<Texture2D> t, float2 p, no_diff uint2 size)
{
    p = clamp(p, float2(0.0), float2(size - 1));
    int2 i = int2(detach(p));
    int2 j = min(i + 1, int2(size) - 1);
    float2 f = p - float2(i);
    float4 v00 = no_diff openpbr_texel_2d(t, i), v10 = no_diff openpbr_texel_2d(t, int2(j.x, i.y));
    float4 v01 = no_diff openpbr_texel_2d(t, int2(i.x, j.y)), v11 = no_diff openpbr_texel_2d(t, j);
    return lerp(lerp(v00, v10, f.x), lerp(v01, v11, f.x), f.y);
}

[Differentiable]
float4 openpbr_lut_trilinear(no_diff DescriptorHandle<Texture3D> t, float3 p, no_diff uint3 size)
{
    p = clamp(p, float3(0.0), float3(size - 1));
    int3 i = int3(detach(p));
    int3 j = min(i + 1, int3(size) - 1);
    float3 f = p - float3(i);
    float4 v000 = no_diff openpbr_texel_3d(t, i), v100 = no_diff openpbr_texel_3d(t, int3(j.x, i.y, i.z));
    float4 v010 = no_diff openpbr_texel_3d(t, int3(i.x, j.y, i.z)), v110 = no_diff openpbr_texel_3d(t, int3(j.x, j.y, i.z));
    float4 v0 = lerp(lerp(v000, v100, f.x), lerp(v010, v110, f.x), f.y);
    float4 v001 = no_diff openpbr_texel_3d(t, int3(i.x, i.y, j.z)), v101 = no_diff openpbr_texel_3d(t, int3(j.x, i.y, j.z));
    float4 v011 = no_diff openpbr_texel_3d(t, int3(i.x, j.y, j.z)), v111 = no_diff openpbr_texel_3d(t, int3(j.x, j.y, j.z));
    return lerp(v0, lerp(lerp(v001, v101, f.x), lerp(v011, v111, f.x), f.y), f.z);
}

/// OpenPBR's energy and LTC tables, interpolated in code since hardware filtering has no derivatives.
/// (The library's own array tables are not used: in programs with backward derivatives, Slang 2026.12
/// computes their lookups as zero.)
[Differentiable]
float4 openpbr_lut_2d(no_diff OpenPBR_LutId lut_id, float2 uv)
{
    // As created by OpenPBRMaterial: the ideal metal average energy table is one-dimensional (one row).
    uint height = lut_id == OpenPBR_LutId_IdealMetalAverageEnergyComplement ? 1 : OpenPBR_EnergyTableSize;
    uint2 size = lut_id == OpenPBR_LutId_LTC ? uint2(OpenPBR_LTCTableSize, OpenPBR_LTCTableSize)
                                             : uint2(OpenPBR_EnergyTableSize, height);
    return openpbr_lut_bilinear(no_diff openpbr_table_2d(lut_id), uv * float2(size) - 0.5, size);
}

[Differentiable]
float4 openpbr_lut_3d(no_diff OpenPBR_LutId lut_id, float3 uv)
{
    return openpbr_lut_trilinear(no_diff openpbr_table_3d(lut_id), uv * float(OpenPBR_EnergyTableSize) - 0.5,
                                 uint3(OpenPBR_EnergyTableSize));
}

/// Layout of OpenPBRMaterial.Attributes, whose fields are internal to the render module.
struct PbrFloat
{
    float16_t value;
    uint16_t texture_channel;
    TextureHandle texture_handle;
};

struct PbrFloat3
{
    float16_t3 value;
    uint16_t pad;
    TextureHandle texture_handle;
};

struct PbrAttributes
{
    PbrFloat base_weight;
    PbrFloat3 base_color;
    PbrFloat base_diffuse_roughness;
    PbrFloat base_metalness;
    PbrFloat specular_weight;
    PbrFloat3 specular_color;
    PbrFloat specular_roughness;
    PbrFloat specular_roughness_anisotropy;
    PbrFloat specular_ior;
    PbrFloat coat_weight;
    PbrFloat3 coat_color;
    PbrFloat coat_roughness;
    PbrFloat coat_roughness_anisotropy;
    PbrFloat coat_ior;
    PbrFloat coat_darkening;
    PbrFloat fuzz_weight;
    PbrFloat3 fuzz_color;
    PbrFloat fuzz_roughness;
    PbrFloat transmission_weight;
    PbrFloat3 transmission_color;
    PbrFloat transmission_depth;
    PbrFloat3 transmission_scatter;
    PbrFloat transmission_scatter_anisotropy;
    PbrFloat transmission_dispersion_scale;
    PbrFloat transmission_dispersion_abbe_number;
    PbrFloat thin_film_weight;
    PbrFloat thin_film_thickness;
    PbrFloat thin_film_ior;
    PbrFloat emission_luminance;
    PbrFloat3 emission_color;
    PbrFloat subsurface_weight;
    PbrFloat3 subsurface_color;
    PbrFloat subsurface_scatter_anisotropy;
};

[Differentiable]
float attribute(float theta, no_diff PbrFloat a, no_diff float2 uv, no_diff uint slot)
{
    float4 sampled = a.texture_handle.sample(ExplicitLodSampler(), uv, float4(1.0));
    return param(theta, float(a.value), slot)
        * channel(texture_param(theta, a.texture_handle.data, uv, sampled), a.texture_channel);
}

[Differentiable]
float3 attribute(float theta, no_diff PbrFloat3 a, no_diff float2 uv, no_diff uint slot)
{
    float4 sampled = a.texture_handle.sample(ExplicitLodSampler(), uv, float4(1.0));
    return param3(theta, float3(a.value), slot) * texture_param(theta, a.texture_handle.data, uv, sampled).rgb;
}

/// Texture index and size of OpenPBR texture `role`: the attributes in declaration order (0-29), the normal
/// map (30), subsurface weight, color and scatter anisotropy (31-33). The dispersion attributes (23, 24) have none.
uint3 openpbr_texture(OpenPBRMaterial m, uint role)
{
    PbrAttributes a = m.attributes_buffer.load<PbrAttributes>(0);
    uint textures[34] = {
        a.base_weight.texture_handle.data, a.base_color.texture_handle.data,
        a.base_diffuse_roughness.texture_handle.data, a.base_metalness.texture_handle.data,
        a.specular_weight.texture_handle.data, a.specular_color.texture_handle.data,
        a.specular_roughness.texture_handle.data, a.specular_roughness_anisotropy.texture_handle.data,
        a.specular_ior.texture_handle.data, a.coat_weight.texture_handle.data, a.coat_color.texture_handle.data,
        a.coat_roughness.texture_handle.data, a.coat_roughness_anisotropy.texture_handle.data,
        a.coat_ior.texture_handle.data, a.coat_darkening.texture_handle.data, a.fuzz_weight.texture_handle.data,
        a.fuzz_color.texture_handle.data, a.fuzz_roughness.texture_handle.data,
        a.transmission_weight.texture_handle.data, a.transmission_color.texture_handle.data,
        a.transmission_depth.texture_handle.data, a.transmission_scatter.texture_handle.data,
        a.transmission_scatter_anisotropy.texture_handle.data, 0xffffffff, 0xffffffff,
        a.thin_film_weight.texture_handle.data, a.thin_film_thickness.texture_handle.data,
        a.thin_film_ior.texture_handle.data, a.emission_luminance.texture_handle.data,
        a.emission_color.texture_handle.data, m.normal_texture_handle.data,
        a.subsurface_weight.texture_handle.data, a.subsurface_color.texture_handle.data,
        a.subsurface_scatter_anisotropy.texture_handle.data
    };
    return texture_info(textures[role], false);
}

/// OpenPBRMaterial.setup_material_instance() with attributes routed through param().
[Differentiable]
OpenPBR_ResolvedInputs openpbr_inputs(float theta, no_diff Surface s)
{
    PbrAttributes a = no_diff load_attributes(s);
    float2 uv = s.si.uv;
    uint k = s.slot;
    OpenPBR_ResolvedInputs i = no_diff openpbr_make_default_resolved_inputs();
    i.base_weight = attribute(theta, a.base_weight, uv, k + 0);
    i.base_color = attribute(theta, a.base_color, uv, k + 1);
    i.base_diffuse_roughness = attribute(theta, a.base_diffuse_roughness, uv, k + 4);
    i.base_metalness = attribute(theta, a.base_metalness, uv, k + 5);
    i.specular_weight = attribute(theta, a.specular_weight, uv, k + 6);
    i.specular_color = attribute(theta, a.specular_color, uv, k + 7);
    i.specular_roughness = attribute(theta, a.specular_roughness, uv, k + 10);
    i.specular_roughness_anisotropy = attribute(theta, a.specular_roughness_anisotropy, uv, k + 11);
    i.specular_ior = attribute(theta, a.specular_ior, uv, k + 12);
    i.coat_weight = attribute(theta, a.coat_weight, uv, k + 13);
    i.coat_color = attribute(theta, a.coat_color, uv, k + 14);
    i.coat_roughness = attribute(theta, a.coat_roughness, uv, k + 17);
    i.coat_roughness_anisotropy = attribute(theta, a.coat_roughness_anisotropy, uv, k + 18);
    i.coat_ior = attribute(theta, a.coat_ior, uv, k + 19);
    i.coat_darkening = attribute(theta, a.coat_darkening, uv, k + 20);
    i.fuzz_weight = attribute(theta, a.fuzz_weight, uv, k + 21);
    i.fuzz_color = attribute(theta, a.fuzz_color, uv, k + 22);
    i.fuzz_roughness = attribute(theta, a.fuzz_roughness, uv, k + 25);
    i.transmission_weight = attribute(theta, a.transmission_weight, uv, k + 26);
    i.transmission_color = attribute(theta, a.transmission_color, uv, k + 27);
    i.transmission_depth = attribute(theta, a.transmission_depth, uv, k + 30);
    i.transmission_scatter = attribute(theta, a.transmission_scatter, uv, k + 31);
    i.transmission_scatter_anisotropy = attribute(theta, a.transmission_scatter_anisotropy, uv, k + 34);
    // OpenPBRMaterial does not set the dispersion attributes (zero, without textures).
    i.transmission_dispersion_scale = param(theta, float(a.transmission_dispersion_scale.value), k + 35);
    i.transmission_dispersion_abbe_number = param(theta, float(a.transmission_dispersion_abbe_number.value), k + 36);
    i.thin_film_weight = attribute(theta, a.thin_film_weight, uv, k + 37);
    i.thin_film_thickness = attribute(theta, a.thin_film_thickness, uv, k + 38);
    i.thin_film_ior = attribute(theta, a.thin_film_ior, uv, k + 39);
    i.emission_luminance = attribute(theta, a.emission_luminance, uv, k + 40);
    i.emission_color = attribute(theta, a.emission_color, uv, k + 41);
    i.subsurface_weight = attribute(theta, a.subsurface_weight, uv, k + 45);
    i.subsurface_color = attribute(theta, a.subsurface_color, uv, k + 46);
    i.subsurface_scatter_anisotropy = attribute(theta, a.subsurface_scatter_anisotropy, uv, k + 49);
    i.geometry_thin_walled = (s.openpbr.header.flags & MaterialFlags::thin_walled) != MaterialFlags::none;
    // The shading frame of OpenPBRMaterial.setup_material_instance().
    float4 sampled = s.openpbr.normal_texture_handle.sample(ExplicitLodSampler(), uv, float4(0.0, 0.0, 1.0, 0.0));
    Frame frame = shading_frame(theta, s, s.openpbr.normal_texture_handle.data, sampled,
                                param(theta, s.openpbr.normal_texture_scale, k + 44), false);
    i.geometry_basis.n = frame.normal;
    i.geometry_basis.t = frame.tangent;
    i.geometry_basis.b = frame.bitangent;
    i.geometry_coat_basis = i.geometry_basis;
    return i;
}

PbrAttributes load_attributes(Surface s) { return s.openpbr.attributes_buffer.load<PbrAttributes>(0); }

/// OpenPBR BSDF values (including foreshortening) for two outgoing directions, or zero for a zero direction.
[Differentiable]
void eval_openpbr(float theta, no_diff Surface s, float3 wi_ws, float3 wo1, float3 wo2, out float3 f1, out float3 f2)
{
    OpenPBR_ResolvedInputs inputs = openpbr_inputs(theta, s);
    OpenPBR_PreparedBsdf bsdf
        = openpbr_prepare(inputs, float3(1.0), OpenPBR_BaseRgbWavelengths_nm, s.si.exterior_ior, wi_ws);
    float3 f[2] = { float3(0), float3(0) };
    // Unroll the fixed directions to work around Vulkan reverse-mode loop failures.
    [ForceUnroll]
    for (uint d = 0; d < 2; d++) {
        float3 wo = d == 0 ? wo1 : wo2;
        if (any(detach(wo) != 0)) {
            OpenPBR_DiffuseSpecular value = openpbr_eval(bsdf, wo);
            f[d] = value.diffuse + value.specular;
        }
    }
    f1 = f[0];
    f2 = f[1];
}

[Differentiable]
float3 openpbr_emission(float theta, no_diff Surface s)
{
    PbrAttributes a = no_diff load_attributes(s);
    return attribute(theta, a.emission_luminance, s.si.uv, s.slot + 40)
        * attribute(theta, a.emission_color, s.si.uv, s.slot + 41);
}
